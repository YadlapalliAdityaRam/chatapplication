      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --nexus-bg: #011F5B;\n    --nexus-glass: rgba(248, 248, 255, 0.1);\n    --nexus-accent: #0070FF;\n    --nexus-amber: #FFBF00;\n    --nexus-text: #F8F8FF;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background: var(--nexus-bg);\n    min-height: 100vh;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    overflow: hidden;\n    color: var(--nexus-text);\n  }\n\n  .glass-panel {\n    background: var(--nexus-glass);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    border-radius: 24px;\n    width: 100%;\n    max-width: 800px;\n    height: 80vh;\n    display: flex;\n    flex-direction: column;\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 40px rgba(0, 112, 255, 0.1);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .chat-header {\n    padding: 20px 24px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    background: rgba(255, 255, 255, 0.02);\n    z-index: 20;\n  }\n\n  .header-left {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .avatar-placeholder {\n    width: 40px;\n    height: 40px;\n    border-radius: 12px;\n    background: rgba(255, 255, 255, 0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .status-indicator {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 13px;\n    font-weight: 500;\n    color: var(--nexus-amber);\n  }\n\n  .spinner {\n    width: 14px;\n    height: 14px;\n    border: 2px solid rgba(255, 191, 0, 0.2);\n    border-top-color: var(--nexus-amber);\n    border-radius: 50%;\n    animation: spin 0.8s linear infinite;\n  }\n\n  @keyframes spin {\n    to { transform: rotate(360deg); }\n  }\n\n  .server-banner {\n    background: rgba(255, 191, 0, 0.15);\n    border-bottom: 1px solid rgba(255, 191, 0, 0.2);\n    padding: 10px 24px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    font-size: 14px;\n    color: #ffd700;\n    z-index: 10;\n    transform: translateY(-100%);\n  }\n\n  .chat-feed {\n    flex: 1;\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    overflow-y: auto;\n  }\n\n  .skeleton-bubble {\n    max-width: 60%;\n    padding: 16px;\n    border-radius: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .skeleton-bubble.theirs {\n    align-self: flex-start;\n    background: rgba(255, 255, 255, 0.05);\n    border-bottom-left-radius: 4px;\n  }\n\n  .skeleton-bubble.mine {\n    align-self: flex-end;\n    background: rgba(0, 112, 255, 0.1);\n    border-bottom-right-radius: 4px;\n  }\n\n  .skeleton-line {\n    height: 12px;\n    background: rgba(255, 255, 255, 0.08);\n    border-radius: 6px;\n    width: 100%;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .skeleton-line::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);\n    animation: shimmer 1.5s infinite;\n  }\n\n  @keyframes shimmer {\n    0% { transform: translateX(-100%); }\n    100% { transform: translateX(100%); }\n  }\n\n  .chat-footer {\n    padding: 20px 24px;\n    border-top: 1px solid rgba(255, 255, 255, 0.08);\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    background: rgba(255, 255, 255, 0.02);\n  }\n\n  .input-skeleton {\n    flex: 1;\n    height: 44px;\n    background: rgba(255, 255, 255, 0.05);\n    border-radius: 22px;\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .action-skeleton {\n    width: 44px;\n    height: 44px;\n    background: rgba(255, 255, 255, 0.05);\n    border-radius: 12px;\n  }\n\n  /* Lenis CSS */\n  html.lenis {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto;\n  }\n</style>\n\n<div class=\"glass-panel\" data-kid=\"1\">\n  \n  <header class=\"chat-header\" data-kid=\"2\">\n    <div class=\"header-left\" data-kid=\"3\">\n      <div class=\"avatar-placeholder\" data-kid=\"4\">\n        <i class=\"ti ti-user-circle\" style=\"font-size: 24px; opacity: 0.5;\" data-kid=\"5\"></i>\n      </div>\n      <div data-kid=\"6\">\n        <div style=\"font-weight: 600; font-size: 15px;\" data-kid=\"7\">nexus_support</div>\n        <div class=\"status-indicator\" data-kid=\"8\">\n          <div class=\"spinner\" data-kid=\"9\"></div>\n          <span data-kid=\"10\">Connecting...</span>\n        </div>\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 12px; opacity: 0.5;\" data-kid=\"11\">\n      <i class=\"ti ti-dots-vertical\" style=\"font-size: 20px;\" data-kid=\"12\"></i>\n      <i class=\"ti ti-x\" style=\"font-size: 20px;\" data-kid=\"13\"></i>\n    </div>\n  </header>\n\n  \n  <div id=\"wakingBanner\" class=\"server-banner\" data-kid=\"14\">\n    <i class=\"ti ti-server-cog\" style=\"font-size: 18px;\" data-kid=\"15\"></i>\n    <span data-kid=\"16\"><strong data-kid=\"17\">Server is waking up...</strong> grabbing your messages (this can take 30s).</span>\n  </div>\n\n  \n  <main class=\"chat-feed\" id=\"chatFeed\" data-kid=\"18\">\n    \n    <div class=\"skeleton-bubble theirs\" data-kid=\"19\">\n      <div class=\"skeleton-line\" style=\"width: 80%;\" data-kid=\"20\"></div>\n      <div class=\"skeleton-line\" style=\"width: 60%;\" data-kid=\"21\"></div>\n    </div>\n    \n    \n    <div class=\"skeleton-bubble mine\" data-kid=\"22\">\n      <div class=\"skeleton-line\" style=\"width: 90%;\" data-kid=\"23\"></div>\n    </div>\n\n    \n    <div class=\"skeleton-bubble theirs\" data-kid=\"24\">\n      <div class=\"skeleton-line\" style=\"width: 70%;\" data-kid=\"25\"></div>\n      <div class=\"skeleton-line\" style=\"width: 85%;\" data-kid=\"26\"></div>\n      <div class=\"skeleton-line\" style=\"width: 40%;\" data-kid=\"27\"></div>\n    </div>\n\n    \n    <div class=\"skeleton-bubble mine\" data-kid=\"28\">\n      <div class=\"skeleton-line\" style=\"width: 50%;\" data-kid=\"29\"></div>\n    </div>\n\n    \n    <div class=\"skeleton-bubble theirs\" data-kid=\"30\">\n      <div class=\"skeleton-line\" style=\"width: 95%;\" data-kid=\"31\"></div>\n      <div class=\"skeleton-line\" style=\"width: 60%;\" data-kid=\"32\"></div>\n    </div>\n  </main>\n\n  \n  <footer class=\"chat-footer\" data-kid=\"33\">\n    <div class=\"action-skeleton\" data-kid=\"34\"></div>\n    <div class=\"input-skeleton\" data-kid=\"35\"></div>\n    <div class=\"action-skeleton\" style=\"background: rgba(0, 112, 255, 0.2);\" data-kid=\"36\"></div>\n  </footer>\n</div>\n\n<script type=\"module\" data-kid=\"37\">\n  import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n  import Lenis from \"https://esm.sh/lenis@1\";\n\n  // Initialize Lenis for smooth scroll in feed\n  const lenis = new Lenis({\n    wrapper: document.getElementById('chatFeed'),\n    autoRaf: true,\n  });\n\n  // Animate Banner Dropdown\n  animate(\"#wakingBanner\", { y: 0 }, { \n    delay: 0.5, \n    type: \"spring\", \n    visualDuration: 0.6, \n    bounce: 0.2 \n  });\n\n  // Animate Skeletons appearing with spring\n  animate(\".skeleton-bubble\", { opacity: [0, 1], y: [20, 0] }, {\n    delay: (i) => i * 0.1,\n    type: \"spring\",\n    visualDuration: 0.5\n  });\n\n</script>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"38\">",
      "comments": [],
      "created": "2026-06-12T15:15:18.907629+00:00",
